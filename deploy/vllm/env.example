# Conda 与部署路径
VLLM_CONDA_ENV=j-serve
VLLM_CONDA_SH=/home/kai/miniconda3/etc/profile.d/conda.sh
VLLM_UV_CACHE_DIR=/home/kai/zyz/Job/.cache/uv
VLLM_PIP_CACHE_DIR=/home/kai/zyz/Job/.cache/pip
VLLM_MODEL_PATH=/home/kai/zyz/Over/hf_home/hub/models--Qwen--Qwen2.5-7B-Instruct/snapshots/a09a35458c702b33eeacc393d103063234e8bc28
VLLM_ADAPTER_PATH=/home/kai/zyz/Job/jobpilot-llm/outputs/qwen2.5-7b-qlora-r16-v1

# OpenAI-compatible API 中展示的模型名
VLLM_BASE_MODEL_NAME=jobpilot-base
VLLM_LORA_MODEL_NAME=jobpilot-lora-v1

# 服务仅监听服务器回环地址，通过 SSH 隧道访问
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_API_KEY=

# 服务器物理 GPU 编号。设置 CUDA_VISIBLE_DEVICES 后，vLLM 内部会将它视为 cuda:0
VLLM_PHYSICAL_GPU=1
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_MEMORY_UTILIZATION=0.90
VLLM_MAX_NUM_SEQS=4

# 当前 LoRA 训练 rank=16
VLLM_MAX_LORA_RANK=16
VLLM_MAX_LORAS=1

# 服务器系统 nvcc 为 CUDA 11.8，关闭需要现场编译的 FlashInfer sampler。
# 注意力后端仍使用 FlashAttention 2，不影响模型权重或 LoRA。
VLLM_USE_FLASHINFER_SAMPLER=0

# 进程管理与保护：默认拒绝在已有显存占用超过 512 MiB 的 GPU 上启动
VLLM_SESSION_NAME=jobpilot_vllm
VLLM_BUSY_GPU_THRESHOLD_MIB=512
VLLM_ALLOW_BUSY_GPU=0
