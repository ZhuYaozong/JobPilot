# 服务只监听本机，避免模型接口意外暴露到局域网。
RAG_MODELS_HOST=127.0.0.1
RAG_MODELS_PORT=7997

# 模型既可以填写 Hugging Face 仓库名，也可以填写本地 snapshot 绝对路径。
RAG_MODELS_DEVICE=cuda:0
RAG_MODELS_USE_FP16=true
RAG_MODELS_LOAD_MODELS_ON_STARTUP=true
RAG_MODELS_EMBEDDING_MODEL=BAAI/bge-m3
RAG_MODELS_EMBEDDING_MODEL_NAME=BAAI/bge-m3
RAG_MODELS_EMBEDDING_BATCH_SIZE=16
RAG_MODELS_EMBEDDING_MAX_LENGTH=512
RAG_MODELS_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_MODELS_RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RAG_MODELS_RERANKER_BATCH_SIZE=8
RAG_MODELS_RERANKER_MAX_LENGTH=512
RAG_MODELS_RERANKER_NORMALIZE_SCORES=true
